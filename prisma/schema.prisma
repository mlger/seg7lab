// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Ownership: anonymous per-browser owner token sent via the `x-sevenseg-owner`
// request header (see src/lib/owner.ts). `ownerId = null` means a shared /
// legacy row created before ownership existed — readable (and writable) by
// everyone so existing demo data keeps working.

model Project {
  id        String   @id @default(cuid())
  name      String
  inputBits Int      @default(4)
  data      String   // full project JSON blob (validated + canonicalized on write)
  ownerId   String?  // owning browser token; null = shared/legacy row
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([ownerId])
}

model Preset {
  id        String   @id // client-supplied id, must match "user:" + safe charset (NOT cuid)
  kind      String        // "table" | "font"
  name      String
  data      String   // full preset JSON blob (validated + canonicalized on write)
  ownerId   String?  // owning browser token; null = shared/legacy row
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([ownerId])
}